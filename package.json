{
  "name": "yomidori-momo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#server/*": {
      "development": "./server/src/*.ts",
      "default": "./dist/server/*.js"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --conditions=development --import tsx --watch server/src/index.ts",
    "typecheck": "tsc -p client && tsc -p server --noEmit && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run typecheck && vite build && tsc -p server",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
